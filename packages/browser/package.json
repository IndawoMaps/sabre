{
  "name": "@sabremaps/browser",
  "version": "0.1.0",
  "description": "Render Cloud-Optimized GeoTIFF tiles in the browser: range reads, five style modes, reprojection, in a Web Worker. No server.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "wasm/sabre_browser.js",
    "wasm/sabre_browser_bg.wasm",
    "LICENSE.md"
  ],
  "sideEffects": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IndawoMaps/sabre.git",
    "directory": "packages/browser"
  },
  "homepage": "https://github.com/IndawoMaps/sabre/tree/main/packages/browser#readme",
  "bugs": "https://github.com/IndawoMaps/sabre/issues",
  "keywords": [
    "cog",
    "geotiff",
    "raster",
    "tiles",
    "wasm",
    "webworker"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node -e \"require('fs').statSync('wasm/sabre_browser_bg.wasm')\" && cp ../../LICENSE.md ."
  }
}
