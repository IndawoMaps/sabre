# Build output
target
build
node_modules
dist
.vite
.wrangler

# OS / editor
.DS_Store
*.swp

# Python
.venv
__pycache__
.pytest_cache

# Raster data — large, not source. Test fixtures are the exception. Local
# rasters for `just serve` and `just native` go in data/.
data/
*.tif
*.tiff
*.aux.xml
!crates/core/tests/fixtures/*.tiff
!crates/core/tests/fixtures/*.tif

# Block sets for the real-workload benchmarks, built by bench/make_blocks.py
# from whatever field boundaries you point it at.
bench/blocks/

# Browser benchmark runs: numbers and screenshots, one folder per run.
bench/browser/results/

# wasm-bindgen output — build artifacts. `just browser` writes the copy the
# bare-wasm examples load, `just npm` the package's.
examples/wasm/pkg/
packages/browser/wasm/
# Copied in by each package's prepack, so the tarball carries the licence.
packages/*/LICENSE.md

# @sabremaps/react-native: native libraries built from crates/mobile by
# `just rn-android` / `just rn-ios`, and its compiled JS. Shipped in the
# tarball, not the repo.
packages/react-native/android/src/main/jniLibs/
packages/react-native/android/build/
packages/react-native/ios/SabreFFI.xcframework/
packages/react-native/build/

# Written by CI to point chromedriver at the Chrome it installed. Lives in
# the package directory because that is where wasm-bindgen-test-runner looks;
# see .github/workflows/ci.yml.
crates/browser/webdriver.json
